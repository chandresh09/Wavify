# Base URL of the existing backend API
VITE_API_BASE_URL=http://localhost:3000/api

# Auth: "true" sends cookies with every request (needed for cookie/JWT-cookie sessions).
# Set to "false" if your backend uses only Bearer tokens returned in the login response.
VITE_USE_COOKIES=true

# Create Music request field names (adjust to match your backend)
VITE_MUSIC_FILE_FIELD=music
VITE_MUSIC_URL_FIELD=uri
