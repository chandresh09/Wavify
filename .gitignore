# ---------------------------------------------------------------
# Wavify (monorepo: Backend/ + Frontend/)
# Patterns without a leading slash apply to every folder.
# ---------------------------------------------------------------

# Dependencies
node_modules/
.pnp
.pnp.js

# Environment files: never commit real secrets
.env
.env.*
*.env
# ...but DO commit the example files
!.env.example
!.env.*.example

# Build output
dist/
dist-ssr/
build/
.vite/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test and coverage output
coverage/
.nyc_output/

# Caches
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
*.tsbuildinfo
.npm/
.node_repl_history

# Local file uploads (if you ever switch from memory storage to disk)
uploads/
tmp/
temp/

# Editor and IDE files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
*.suo
*.sln
*.sw?

# OS files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Archives and packaged output
*.zip
*.tgz
*.tar.gz
